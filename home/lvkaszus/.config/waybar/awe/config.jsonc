{
    "layer": "top",
    "position": "top",
    "height": 36,

    "margin": "0, 0, 0, 0",

    // Choose the order of the modules
    "modules-left": [
        "custom/wmname",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "custom/separator",
        "temperature",
        "custom/separator",
        "memory",
        "custom/separator",
        "network",
        "custom/separator",
        "backlight",
        "custom/separator",
        "battery",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "clock",
        "custom/separator",
        "idle_inhibitor",
        "custom/separator",
        "tray",
        "custom/separator",
        "custom/power"
    ],

    // Modules configuration
    "custom/wmname": {
        "format": "\uf798",
        "tooltip": false,
    },
    "hyprland/workspaces": {},
    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },
    "idle_inhibitor": {
        // Tooltip shown on hover: "Idle inhibitor ON: the screen will not turn off or lock, and the computer will not suspend"
        "tooltip-format-activated": "Blokada bezczynności włączona: ekran się nie wygasi ani nie zablokuje, a komputer nie uśnie",
        // Tooltip shown on hover: "Idle inhibitor OFF: the screen will turn off and lock, and the computer will suspend when idle"
        "tooltip-format-deactivated": "Blokada bezczynności wyłączona: ekran się wygasi i zablokuje, a komputer uśnie po bezczynności",
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 20,
        "spacing": 6
    },
    "clock": {
        "interval": 1,
        "locale": "pl_PL.utf8",
        "format": " {:%H:%M:%S}",
        "format-alt": " {:L%A, %d %B %Y}"
    },
    "cpu": {
        "format": "&#8239; {usage}%",
        "tooltip": false,
        "on-click": "kitty -e 'htop'"
    },
    "memory": {
        "interval": 30,
        "format": " {used:0.2f}GB",

        "max-length": 10,
        "tooltip": false,
        "warning": 70,
        "critical": 90
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{icon}&#8239; {temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon}&#8239; {percent}%",
        "format-icons": ["\uf185", "\uf185"],
        "tooltip": false,
        "on-scroll-down": "brightnessctl -c backlight set 1%-",
        "on-scroll-up": "brightnessctl -c backlight set +1%"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}&#8239; {capacity}%",
        "format-charging": "&#8239; {capacity}%",
        "format-plugged": "&#8239; {capacity}%",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
        // "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "&#8239; ({signalStrength}%)",
        "format-ethernet": "&#8239; {ifname}: {ipaddr}/{cidr}",
        // Shown when the interface is linked but has no IP address: "(No IP)"
        "format-linked": "&#8239; {ifname} (Brak IP)",
        // Shown when there is no connection: "Disconnected"
        "format-disconnected": "\uf072&#8239; Rozłączono",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{essid}: {ipaddr}"
    },
    "pulseaudio": {
      // "scroll-step": 1, // %, can be a float
      "format": "{icon} {volume}% {format_source}",
      "format-bluetooth": "{icon} {volume}% {format_source}",
      "format-bluetooth-muted": " {format_source}",
      "format-muted": "  {format_source}",
      "format-source": " {volume}%",
      "format-source-muted": "",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "🎧",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/awe/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "logout": "uwsm stop",
            "suspend": "systemctl suspend",
            // "hibernate": "systemctl hibernate",  // needs swap >= RAM + resume= configured
            "reboot": "reboot",
            "shutdown": "poweroff"
        }
    }
}
